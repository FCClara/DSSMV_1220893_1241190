<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.Funcionario">

    <Button
        android:id="@+id/goPrecoProduto"
        android:layout_width="162dp"
        android:layout_height="46dp"
        android:text="Precos"
        app:layout_constraintBottom_toTopOf="@+id/buttonGoCodigoBarras"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonGoListProdutos" />

    <Button
        android:id="@+id/buttonGoListProdutos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ver Produtos"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/goPrecoProduto"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <Button
        android:id="@+id/buttonGoCodigoBarras"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ler Código de Barras"
        app:layout_constraintBottom_toTopOf="@+id/buttonGoHorario"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/goPrecoProduto" />

    <Button
        android:id="@+id/buttonGoHorario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Horario"
        app:layout_constraintBottom_toTopOf="@+id/buttonGoListaTurnos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonGoCodigoBarras" />

    <Button
        android:id="@+id/buttonGoListaTurnos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lista Turnos"
        app:layout_constraintBottom_toTopOf="@+id/buttonGoListaFuncionarios"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonGoHorario" />

    <Button
        android:id="@+id/buttonGoListaFuncionarios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ver fichas de funcionários"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/buttonGoCriarTipo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonGoListaTurnos"
        tools:visibility="visible" />

    <Button
        android:id="@+id/buttonGoCriarTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Criar tipo"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/buttonGoCriarFornecedor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonGoListaFuncionarios"
        tools:visibility="visible" />

    <Button
        android:id="@+id/buttonGoCriarFornecedor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Criar fornecedor"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/buttonGoCriarProduto"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonGoCriarTipo"
        tools:visibility="visible" />

    <Button
        android:id="@+id/buttonGoCriarProduto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Criar produto"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonGoCriarFornecedor"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>