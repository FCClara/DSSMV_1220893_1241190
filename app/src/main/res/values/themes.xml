        <item name="android:windowBackground">@drawable/fundo_supermercado</item>

        <!-- Cores dos botões e elementos do layout -->
        <item name="colorPrimary">@color/verde_botao</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/verde_botao</item>

        <!-- Fundo dos elementos do layout para se ver melhor -->
