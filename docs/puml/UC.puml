@startuml
'https://plantuml.com/use-case-diagram

left to right direction

actor "Funcionário" as Funcionario
actor "Gerente" as Gerente
actor "Dono" as Dono

rectangle "Super Fresh" {
  usecase "Verificar produto" as UC1
  usecase "Consultar histórico" as UC2
  usecase "Mover stock" as UC3
  usecase "Verificar preços externos" as UC8
  usecase "Consultar detalhes de funcionário" as UC11
  usecase "Consultar horário" as UC12
  usecase "Trocar turno" as UC14

  usecase "Criar funcionário" as UC10
  usecase "Criar turno" as UC13

  usecase "Registar entrada de stock" as UC4
  usecase "Criar produto" as UC5
  usecase "Criar tipo de produto" as UC6
  usecase "Criar fornecedor" as UC7
  usecase "Alterar preço" as UC9
}

Funcionario --> UC1
Funcionario --> UC2
Funcionario --> UC3
Funcionario --> UC8
Funcionario --> UC11
Funcionario --> UC12
Funcionario --> UC14

Gerente --> UC10
